# Night Vector server configuration. Copy to `.env` for local development; in production set
# real environment variables (they always win over the file). Never commit a real `.env`.

# development | staging | production | test
APP_ENV=development

HOST=0.0.0.0
PORT=8080

# Public origin of the game, used for canonical/Open Graph URLs. No trailing slash.
PUBLIC_URL=http://localhost:8080

# Only if the API is served from a different origin than the game (leave empty otherwise).
API_URL=
# Comma-separated origins allowed to call the API cross-origin (only needed with API_URL).
CORS_ORIGINS=

# SQLite file (created on first start). Use a persistent volume in production.
DATABASE_PATH=data/nightvector.db

# Set to true only behind a reverse proxy that sets X-Forwarded-For (for rate limiting).
TRUST_PROXY=false

# Anonymous gameplay analytics (players can also opt out in Settings; DNT/GPC respected).
ANALYTICS_ENABLED=true

# Multiplies every rate limit (e.g. 10 for load tests on staging). 1 in production.
RATE_LIMIT_SCALE=1

# debug | info | warn | error
LOG_LEVEL=info
